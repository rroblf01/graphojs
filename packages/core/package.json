{
  "name": "graphojs",
  "version": "0.1.0",
  "description": "An open-source, MIT-licensed alternative to GoJS: interactive diagramming for the web.",
  "license": "MIT",
  "author": "Ricardo Robles Fernandez",
  "repository": {
    "type": "git",
    "url": "https://github.com/rroblf01/graphojs"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "diagram",
    "diagramming",
    "graph",
    "canvas",
    "visualization",
    "flowchart",
    "graphojs"
  ],
  "scripts": {
    "build": "tsup && pnpm types",
    "types": "tsc --emitDeclarationOnly --declaration --declarationDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
