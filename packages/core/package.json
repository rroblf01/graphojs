{
  "name": "graphojs",
  "version": "0.2.0",
  "description": "An open-source, MIT-licensed alternative to GoJS: interactive diagramming for the web.",
  "license": "MIT",
  "author": "Ricardo Robles Fernandez",
  "homepage": "https://graphojs.ricardorobles.es/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rroblf01/graphojs"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./go": {
      "types": "./dist/go.d.ts",
      "import": "./dist/go.js",
      "require": "./dist/go.cjs"
    },
    "./templates": {
      "types": "./dist/templates.d.ts",
      "import": "./dist/templates.js",
      "require": "./dist/templates.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    }
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "diagram",
    "diagramming",
    "graph",
    "canvas",
    "visualization",
    "flowchart",
    "graphojs"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --declarationDir dist --noEmit false",
    "prepublishOnly": "pnpm build",
    "types": "tsc --emitDeclarationOnly --declaration --declarationDir dist --noEmit false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vue": "^3.5.0"
  }
}
