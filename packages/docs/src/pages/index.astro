---
import { getCollection } from 'astro:content';
// biome-ignore lint/correctness/noUnusedVariables: used in the Astro template below
const docs = await getCollection('docs');
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>GraphoJS</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 720px; margin: 3rem auto; padding: 0 1rem; color: #222; }
      h1 { color: #1976d2; }
      a { color: #1976d2; }
      li { margin: 0.4rem 0; }
    </style>
  </head>
  <body>
    <h1>GraphoJS</h1>
    <p>Alternativa open-source (MIT) a GoJS: diagramas interactivos con canvas 2D.</p>
    <ul>
      {docs.map((d) => (
        <li>
          <a href={`/${d.id}/`}>{d.data.title}</a>
        </li>
      ))}
    </ul>
  </body>
</html>
