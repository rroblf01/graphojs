{
  "name": "@graphojs/react",
  "version": "0.1.0",
  "description": "React wrapper for GraphoJS, an open-source, MIT-licensed diagramming library.",
  "license": "MIT",
  "author": "Ricardo Robles Fernandez",
  "repository": {
    "type": "git",
    "url": "https://github.com/rroblf01/graphojs"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "diagram",
    "diagramming",
    "graph",
    "react",
    "canvas",
    "graphojs"
  ],
  "peerDependencies": {
    "graphojs": ">=0.1.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --declarationDir dist --noEmit false",
    "prepublishOnly": "pnpm build",
    "types": "tsc --emitDeclarationOnly --declaration --declarationDir dist --noEmit false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "graphojs": "workspace:*"
  }
}
